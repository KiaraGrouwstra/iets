with builtins;
[
  (match "foo" "foo")
  (match "fo*" "f")
  (match "fo+" "f")
  (match "(.*)\\.nix" "foobar.nix")
  (match "((.*)/)?([^/]*)\\.(nix|cc)" "foobar.cc")
  (match "[[:space:]]+([[:upper:]]+)[[:space:]]+" "  FOO   ")
  (match "[\\.]" "\\")
  (match "[[]" "[")
  (match "[]a]" "]")
  (match "[a&&b]" "&")
  (match "[!--]" "-")
  (match "." "\n")
  (match ".." "é")
  (match "(|a)" "a")
  (match "()" "")
  (match "(a+?)" "aa")
  (match "a{1,2}{2}" "aaaa")
  (match "a**" "a")
  (match "(a|ab)(c|bcd)(d*)" "abcd")
  (match "^([0-9][0-9\\.]*)(.*)$" "10.1abc")
  (match "mirror://([a-z]+)/(.*)" "mirror://gnu/m4/m4-1.4.19.tar.bz2")
  (match "[[:alpha:]]+" "é")
  (match "x(a$)" "xa")
]
